# Copy this file to .env and fill it in. Lines starting with # are ignored.

# The public address of the site, with https and no trailing slash. Used in email links.
APP_URL=https://wholesale.yourcompany.ae
PORT=3000
NODE_ENV=production

# Where the database, uploaded documents and product photos are kept. Back this folder up.
DATA_DIR=./data

# First staff account. Read once, on the first start, when no staff account exists yet.
ADMIN_EMAIL=you@yourcompany.ae
ADMIN_PASSWORD=choose-a-long-password

# Email (SMTP). Without these the site works but sends no emails; messages are only recorded in Admin > Setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Blessed Days Cosmetics <orders@yourcompany.ae>"

# Where staff alerts go (new applications, new orders, payment proofs). Defaults to the orders email in Setup.
STAFF_NOTIFY_EMAIL=
